# Active profile: assethub-dev-stub | paseo | polkadot
NEXT_PUBLIC_CHAIN_ENV=assethub-dev-stub

# WalletConnect Cloud project id (required for RainbowKit)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- assethub-dev-stub (defaults: localhost Anvil + chain id 31337 if RPC/CHAIN_ID omitted)
#
# Shared testnet (pre-Paseo) — public HTTPS; MetaMask + portal use chain RPC directly (no /api/rpc proxy):
# NEXT_PUBLIC_RPC_URL_ASSHUB_DEV_STUB=https://rpc-testnet.sparkl.network
# NEXT_PUBLIC_CHAIN_NAME_ASSHUB_DEV_STUB=Sparkl testnet
# NEXT_PUBLIC_RPC_USE_SAME_ORIGIN_PROXY=0
# Contract addresses from sparkl-solo/contracts/deployments/local.json (same deterministic deploy on shared Anvil)
#
# Local only: ANVIL_HOST=0.0.0.0 ./scripts/launch-local.sh — http://127.0.0.1:8545 or LAN :8545; optional portal proxy below.
NEXT_PUBLIC_RPC_URL_ASSHUB_DEV_STUB=http://127.0.0.1:8545
NEXT_PUBLIC_CHAIN_ID_ASSHUB_DEV_STUB=31337
# NEXT_PUBLIC_CHAIN_NAME_ASSHUB_DEV_STUB=Anvil local
NEXT_PUBLIC_OPERATOR_REGISTRY_ADDRESS_ASSHUB_DEV_STUB=0x0000000000000000000000000000000000000000
# Must be deployed SettlementEscrow — zero address disables /user fund deposits (burn-only sends).
NEXT_PUBLIC_SETTLEMENT_ESCROW_ADDRESS_ASSHUB_DEV_STUB=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_MODEL_PRICE_ORACLE_ADDRESS_ASSHUB_DEV_STUB=0x0000000000000000000000000000000000000000

# Optional: native gas token metadata for Switch network / MetaMask (must match SettlementEscrow.nativeDotDecimals on-chain)
# NEXT_PUBLIC_NATIVE_DECIMALS_ASSHUB_DEV_STUB=18
# NEXT_PUBLIC_NATIVE_SYMBOL_ASSHUB_DEV_STUB=ETH
# NEXT_PUBLIC_NATIVE_NAME_ASSHUB_DEV_STUB=Ether

# If the browser tab cannot reach raw :8545 (CORS): same-origin RPC proxy for portal reads only — not for MetaMask sends.
# Wagmi publicClient uses http(s)://<dev host>/api/rpc; Node forwards to RPC_PROXY_TARGET (127.0.0.1 when Next and Anvil share a host).
# NEXT_PUBLIC_RPC_USE_SAME_ORIGIN_PROXY=1
# RPC_PROXY_TARGET=http://127.0.0.1:8545
# RPC_PROXY_DEBUG=0   # in development, /api/rpc logs [rpc-proxy] lines to the Next server terminal; set 0 to silence
# RPC_PROXY_DEBUG=1   # force those logs even outside development
# RPC_PROXY_DEBUG_PAYLOAD=0   # keep summary line only (no req/resp JSON); default is to log truncated req/resp when debug is on
# Optional: fixed proxy URL for unusual setups (must match how you open the app if SSR ever ran wagmi; client-only init usually makes this unnecessary):
# NEXT_PUBLIC_RPC_PUBLIC_PROXY_URL=http://192.168.10.199:3000/api/rpc

# --- paseo (Hub EVM testnet) — fill from sparkl-solo/contracts/deployments/paseo.json after deploy
NEXT_PUBLIC_RPC_URL_PASEO=
NEXT_PUBLIC_CHAIN_ID_PASEO=
NEXT_PUBLIC_OPERATOR_REGISTRY_ADDRESS_PASEO=
NEXT_PUBLIC_SETTLEMENT_ESCROW_ADDRESS_PASEO=
NEXT_PUBLIC_MODEL_PRICE_ORACLE_ADDRESS_PASEO=

# Optional native overrides (defaults: decimals 10, symbol/name DOT)
# NEXT_PUBLIC_NATIVE_DECIMALS_PASEO=10
# NEXT_PUBLIC_NATIVE_SYMBOL_PASEO=DOT
# NEXT_PUBLIC_NATIVE_NAME_PASEO=DOT

# --- polkadot (mainnet-shaped) — placeholders until live
NEXT_PUBLIC_RPC_URL_POLKADOT=
NEXT_PUBLIC_CHAIN_ID_POLKADOT=
NEXT_PUBLIC_OPERATOR_REGISTRY_ADDRESS_POLKADOT=
NEXT_PUBLIC_SETTLEMENT_ESCROW_ADDRESS_POLKADOT=
NEXT_PUBLIC_MODEL_PRICE_ORACLE_ADDRESS_POLKADOT=

# Optional native overrides (defaults: decimals 10, symbol/name DOT)
# NEXT_PUBLIC_NATIVE_DECIMALS_POLKADOT=10
# NEXT_PUBLIC_NATIVE_SYMBOL_POLKADOT=DOT
# NEXT_PUBLIC_NATIVE_NAME_POLKADOT=DOT

# Sparkl router (session activate / API key recovery)
# Browser: shown in session UI warnings; server route proxies activate to router.
NEXT_PUBLIC_SPARKL_ROUTER_URL=http://127.0.0.1:8080
SPARKL_ROUTER_URL=http://127.0.0.1:8080

# Optional: hex block to start SettlementEscrow event scans (e.g. /node/.../sessions)
# NEXT_PUBLIC_SETTLEMENT_ESCROW_FROM_BLOCK=0

# Optional: hex block number to start ProviderRegistry NodeRegistered log scan
# NEXT_PUBLIC_OPERATOR_REGISTRY_FROM_BLOCK=0

# Optional dev shortcut: comma-separated node IDs (0x + 64 hex each). Skips log scan for getAllRegisteredNodes-style helpers.
# NEXT_PUBLIC_DEV_OPERATOR_NODE_ADDRESSES=0xabc...,0xdef...
